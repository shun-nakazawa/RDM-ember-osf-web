                </OsfLink>
            </ddm.item>
            {{#if (or this.useNavSupport this.useNavGlobalSupport)}}
                <ddm.item role='menuitem'>
                    {{#if this.replaceGlobalSupportUrl}}
                        <a href='{{this.globalSupportURL}}' onclick={{action '_onLinkClicked' 'Navbar - Support'}} target='{{this.globalSupportTarget}}'>
                            <FaIcon @icon='life-ring' class='fa-lg p-r-xs' />
                            {{t 'auth_dropdown.osf_support'}}
                        </a>
                    {{else}}
                        <OsfLink
                            data-test-ad-support
                            data-analytics-name='Support'
                            @route='support'
                        >
                            <FaIcon @icon='life-ring' class='fa-lg p-r-xs' />
                            {{t 'auth_dropdown.osf_support'}}
                        </OsfLink>
                    {{/if}}
                </ddm.item>
            {{/if}}
